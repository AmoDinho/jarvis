# Optional. Without a key, JARVIS uses the local demo architect so every
# screen can still be tested. The key never leaves the server.
ANTHROPIC_API_KEY=

# auto | demo | claude
# auto uses Claude when a key is present, otherwise the demo architect.
JARVIS_BRAIN=auto

# Voice turns. Fast model. Sonnet 5.5 is the default as of October 2026.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Tier 2 renders. Can be a stronger model; defaults to the voice model.
ANTHROPIC_RENDER_MODEL=claude-sonnet-5-5

# Optional session token ceiling. Unset means no ceiling. The HUD shows usage.
# JARVIS_TOKEN_BUDGET=200000

# JARVIS_PORT=8787
